# Copy to .env, which git ignores, and fill in. deploy.sh reads it.
# The TV's address on the LAN.
TV_IP=192.0.2.10
# Samsung's sdb tool, from its standalone download.
SDB=/path/to/tizen-sdb/data/tools/sdb
# The Apps2Samsung command-line installer.
APPS2SAMSUNG_CLI=/path/to/apps2samsung/apps2samsung-cli
